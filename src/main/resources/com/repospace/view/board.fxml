<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.BoardController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <HBox spacing="10.0">
         <children>
            <Button onAction="#handleBack" text="&lt; Back" />
            <Label fx:id="titleLabel" styleClass="title" text="Project board" />
         </children>
      </HBox>
      <Label fx:id="progressLabel" />
      <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0" />
      <HBox spacing="12.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="To do" />
                  <ListView fx:id="todoList" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="In progress" />
                  <ListView fx:id="progressList" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Done" />
                  <ListView fx:id="doneList" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Label fx:id="detailsLabel" wrapText="true" />
      <FlowPane hgap="8.0" vgap="8.0">
         <children>
            <Button fx:id="moveLeftButton" onAction="#handleMoveLeft" text="&lt; Move back" />
            <Button fx:id="moveRightButton" onAction="#handleMoveRight" text="Move forward &gt;" />
            <Button fx:id="deleteCardButton" onAction="#handleDeleteCard" text="Delete card" />
            <Button fx:id="openRepoButton" onAction="#handleOpenRepo" text="Open linked repository" />
         </children>
      </FlowPane>
      <VBox fx:id="addBox" spacing="6.0" styleClass="card">
         <children>
            <Label text="Add a card to To do" />
            <HBox spacing="8.0">
               <children>
                  <TextField fx:id="cardTitleField" promptText="Title" HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="linkedRepoBox" prefWidth="200.0" />
               </children>
            </HBox>
            <TextField fx:id="cardDetailsField" promptText="Details (optional)" />
            <Button onAction="#handleAddCard" text="Add card" />
         </children>
      </VBox>
      <Label fx:id="messageLabel" wrapText="true" />
   </children>
</VBox>
