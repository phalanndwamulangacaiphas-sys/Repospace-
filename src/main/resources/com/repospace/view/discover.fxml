<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.DiscoverController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Discover" />
      <HBox spacing="8.0">
         <children>
            <ComboBox fx:id="modeBox" onAction="#handleModeChanged" />
            <TextField fx:id="searchField" onAction="#handleSearch" promptText="Search for a username" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleSearch" text="Search" />
         </children>
      </HBox>
      <SplitPane dividerPositions="0.28" VBox.vgrow="ALWAYS">
         <items>
            <VBox spacing="6.0">
               <padding>
                  <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
               </padding>
               <children>
                  <Label text="Results" />
                  <ListView fx:id="resultList" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox spacing="8.0">
               <padding>
                  <Insets bottom="6.0" left="10.0" right="6.0" top="6.0" />
               </padding>
               <children>
                  <HBox spacing="14.0">
                     <children>
                        <ImageView fx:id="pictureView" fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="nameLabel" styleClass="title" text="Select a user" />
                              <Label fx:id="joinedLabel" />
                              <Label fx:id="bioLabel" wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Label text="Public projects" />
                  <ListView fx:id="projectList" prefHeight="110.0" />
                  <Button fx:id="profileButton" onAction="#handleOpenProfile" text="Open full profile page" />
                  <Label text="Public repositories (select one to open or download it)" />
                  <ListView fx:id="repoList" prefHeight="130.0" VBox.vgrow="ALWAYS" />
                  <FlowPane hgap="8.0" vgap="8.0">
                     <children>
                        <Button fx:id="openRepoButton" onAction="#handleOpenRepo" text="Open repository page" />
                        <Button fx:id="zipButton" onAction="#handleDownloadZip" text="Download as ZIP..." />
                        <Button fx:id="folderButton" onAction="#handleDownloadFolder" text="Download to a folder..." />
                     </children>
                  </FlowPane>
               </children>
            </VBox>
         </items>
      </SplitPane>
      <Label fx:id="messageLabel" wrapText="true" />
   </children>
</VBox>
