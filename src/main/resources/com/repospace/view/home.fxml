<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.HomePageController">
   <left>
      <VBox prefWidth="190.0" spacing="8.0" styleClass="sidebar">
         <padding>
            <Insets bottom="16.0" left="12.0" right="12.0" top="16.0" />
         </padding>
         <children>
            <ImageView fitWidth="166.0" pickOnBounds="true" preserveRatio="true" smooth="true">
               <image>
                  <Image url="@../images/logo-sidebar.png" />
               </image>
            </ImageView>
            <Label fx:id="welcomeLabel" wrapText="true" />
            <Region prefHeight="10.0" />
            <Button maxWidth="Infinity" onAction="#displayHome" text="Home" />
            <Button maxWidth="Infinity" onAction="#viewProjects" text="Projects" />
            <Button maxWidth="Infinity" onAction="#viewRepositories" text="Repositories" />
            <Button maxWidth="Infinity" onAction="#searchUsers" text="Discover" />
            <Button maxWidth="Infinity" onAction="#viewMyPage" text="My page" />
            <Button maxWidth="Infinity" onAction="#viewProfile" text="Edit profile" />
            <Button maxWidth="Infinity" onAction="#openSettings" text="Settings" />
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#logout" text="Log out" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" />
   </center>
</BorderPane>
