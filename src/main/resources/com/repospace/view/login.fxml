<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="brand-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.LoginPageController">
   <children>
   <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="380.0" spacing="12.0" styleClass="login-card">
      <children>
         <Label styleClass="title" text="Welcome back" />
         <Label text="Sign in to your account" />
         <TextField fx:id="usernameField" promptText="Username or e-mail" />
         <PasswordField fx:id="passwordField" promptText="Password" />
         <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#handleLoginButtonAction" text="Log in" />
         <Hyperlink onAction="#handleRegisterLinkAction" text="Create a new account" />
      </children>
   </VBox>
   </children>
</StackPane>
