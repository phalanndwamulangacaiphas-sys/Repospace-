<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.ProfileController">
<content>
<VBox maxWidth="680.0" spacing="10.0">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Profile" />
      <HBox spacing="16.0">
         <children>
            <ImageView fx:id="pictureView" fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="joinedLabel" />
                  <TextField fx:id="usernameField" promptText="Username" />
                  <TextField fx:id="emailField" promptText="E-mail" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Label text="Bio (up to 500 characters)" />
      <TextArea fx:id="bioArea" prefRowCount="5" wrapText="true" />
      <Label text="Who can see my bio, picture and join date? (private = only me)" />
      <ComboBox fx:id="visibilityBox" />
      <Label text="What I am doing now (a short status, up to 80 characters)" />
      <TextField fx:id="statusField" promptText="For example: Building Repospace for SDN260S" />
      <Label text="Profile README (Markdown, shown at the top of your page). Placeholders: {{commits}} {{repos}} {{streak}} {{top-language}} {{releases}} {{sponsors}} {{member-since}}" wrapText="true" />
      <TextArea fx:id="readmeArea" prefRowCount="8" promptText="# Hi, I am {{username}}&#10;I have made {{commits}} commits in {{repos}} repositories." wrapText="true" />
      <Label text="Profile picture" />
      <HBox spacing="8.0">
         <children>
            <TextField fx:id="pictureField" editable="false" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleChoosePicture" text="Choose..." />
         </children>
      </HBox>
      <HBox spacing="8.0">
         <children>
            <Button onAction="#handleSave" text="Save changes" />
            <Button onAction="#handleViewMyPage" text="See my page" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" wrapText="true" />
   </children>
</VBox>
</content>
</ScrollPane>
