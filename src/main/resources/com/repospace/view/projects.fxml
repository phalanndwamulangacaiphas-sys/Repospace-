<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.ProjectsController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Projects" />
      <HBox spacing="8.0">
         <children>
            <TextField fx:id="nameField" promptText="Project name" HBox.hgrow="ALWAYS" />
            <TextField fx:id="descriptionField" promptText="Description" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="newVisibilityBox" />
            <Button onAction="#handleAddProject" text="Add project" />
         </children>
      </HBox>
      <TableView fx:id="projectTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="nameColumn" prefWidth="160.0" text="Name" />
            <TableColumn fx:id="descriptionColumn" prefWidth="260.0" text="Description" />
            <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status" />
            <TableColumn fx:id="visibilityColumn" prefWidth="90.0" text="Visibility" />
            <TableColumn fx:id="createdColumn" prefWidth="130.0" text="Created" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <ComboBox fx:id="statusBox" />
            <Button onAction="#handleUpdateStatus" text="Set status of selected" />
            <Button onAction="#handleOpenBoard" text="Open board" />
            <Button onAction="#handleToggleVisibility" text="Make selected public / private" />
            <Button onAction="#handleDelete" text="Delete selected" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" wrapText="true" />
   </children>
</VBox>
