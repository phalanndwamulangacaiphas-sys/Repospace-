<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.RepositoryController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Repositories" />
      <TitledPane collapsible="false" text="New repository">
         <content>
            <GridPane hgap="8.0" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="90.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
                  <ColumnConstraints minWidth="90.0" />
                  <ColumnConstraints hgrow="ALWAYS" />
               </columnConstraints>
               <padding>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </padding>
               <children>
                  <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Visibility" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <ComboBox fx:id="visibilityBox" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                  <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
                  <Label text="Folder to track" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="sourceField" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                  <HBox spacing="8.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                     <children>
                        <Button onAction="#handleBrowse" text="Browse..." />
                        <Button onAction="#handleCreateRepo" text="Create repository" />
                     </children>
                  </HBox>
               </children>
            </GridPane>
         </content>
      </TitledPane>
      <SplitPane dividerPositions="0.34" VBox.vgrow="ALWAYS">
         <items>
            <VBox spacing="6.0">
               <padding>
                  <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
               </padding>
               <children>
                  <Label text="Your repositories (and public ones)" />
                  <ListView fx:id="repoList" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox spacing="6.0">
               <padding>
                  <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
               </padding>
               <children>
                  <Label fx:id="selectedLabel" text="Select a repository" wrapText="true" />
                  <HBox spacing="8.0">
                     <children>
                        <TextField fx:id="commitMessageField" promptText="Commit message" HBox.hgrow="ALWAYS" />
                        <Button fx:id="commitButton" onAction="#handleCommit" text="Commit" />
                        <Button fx:id="checkButton" onAction="#handleCheckChanges" text="Check changes" />
                     </children>
                  </HBox>
                  <Label text="History (newest first)" />
                  <ListView fx:id="commitList" prefHeight="130.0" />
                  <TextArea fx:id="detailsArea" editable="false" prefHeight="150.0" VBox.vgrow="ALWAYS" />
                  <FlowPane hgap="8.0" vgap="8.0">
                     <children>
                        <Button fx:id="openPageButton" onAction="#handleOpenPage" text="Open repository page" />
                        <Button fx:id="filesButton" onAction="#handleViewFiles" text="View files" />
                        <Button fx:id="restoreButton" onAction="#handleRestore" text="Restore selected version..." />
                        <Button fx:id="cloneButton" onAction="#handleClone" text="Clone latest..." />
                        <Button fx:id="downloadButton" onAction="#handleDownloadZip" text="Download as ZIP..." />
                        <Button fx:id="visibilityButton" onAction="#handleToggleVisibility" text="Make public" />
                        <Button fx:id="deleteButton" onAction="#handleDeleteRepo" text="Delete repository" />
                     </children>
                  </FlowPane>
               </children>
            </VBox>
         </items>
      </SplitPane>
      <Label fx:id="statusLabel" wrapText="true" />
   </children>
</VBox>
