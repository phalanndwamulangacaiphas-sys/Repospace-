<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="420.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.repospace.controller.SettingsController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Settings" />
      <Label text="Theme" />
      <ComboBox fx:id="themeBox" maxWidth="Infinity" />
      <Label text="Language (saved for future translations; the screens are in English)" wrapText="true" />
      <ComboBox fx:id="languageBox" maxWidth="Infinity" />
      <CheckBox fx:id="notificationsBox" text="Show recent-activity notifications on the home screen" />
      <Button onAction="#handleSave" text="Save settings" />
      <Label fx:id="messageLabel" wrapText="true" />
   </children>
</VBox>
